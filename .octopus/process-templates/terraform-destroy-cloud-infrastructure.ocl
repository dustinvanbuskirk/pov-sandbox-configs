name = "Terraform Destroy Cloud Infrastructure"
description = "Destroy's infrastructure required by project."

icon {
    color = "#D63D3D"
    id = "mixcloud"
}

parameter "Worker Pool" {
    display_settings = {
        Octopus.ControlType = "WorkerPool"
    }
    help_text = ""
    label = ""
}

step "plan-a-terraform-destroy" {
    name = "Plan a Terraform destroy"

    action {
        action_type = "Octopus.TerraformPlanDestroy"
        properties = {
            Octopus.Action.GoogleCloud.ImpersonateServiceAccount = "False"
            Octopus.Action.GoogleCloud.UseVMServiceAccount = "True"
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Terraform.AllowPluginDownloads = "True"
            Octopus.Action.Terraform.AzureAccount = "False"
            Octopus.Action.Terraform.GoogleCloudAccount = "False"
            Octopus.Action.Terraform.ManagedAccount = "None"
            Octopus.Action.Terraform.PlanJsonOutput = "False"
            Octopus.Action.Terraform.RunAutomaticFileSubstitution = "True"
            Octopus.Action.Terraform.Template = <<-EOT
                # main.tf
                
                terraform {
                  required_version = ">= 1.0.0"
                }
                
                # A mock variable you can easily manipulate to trigger simulated changes
                variable "mock_input" {
                  type    = string
                  default = "initial_mock_value"
                }
                
                # Uses the built-in standard provider to create a local, cost-free resource
                resource "terraform_data" "mock_resource" {
                  input = var.mock_input
                
                  # Optional: Simulated output fields
                  triggers_replace = {
                    seed = timestamp()
                  }
                }
                
                # Emulates a real stack output
                output "mock_output_id" {
                  value       = terraform_data.mock_resource.id
                  description = "The simulated ID generated by the mock plan."
                }
                
                EOT
            Octopus.Action.Terraform.TemplateParameters = "{\"mock_input\":\"initial_mock_value\"}"
        }
        worker_pool_variable = "#{Worker Pool}"
    }
}

step "manual-intervention-required" {
    name = "Manual Intervention Required"

    action {
        action_type = "Octopus.Manual"
        properties = {
            Octopus.Action.Manual.BlockConcurrentDeployments = "False"
            Octopus.Action.Manual.Instructions = "This will delete the project infrastructure and requires Octopus Manager approval."
            Octopus.Action.Manual.ResponsibleTeamIds = "global/octopus-managers"
        }
    }
}

step "destroy-terraform-resources" {
    name = "Destroy Terraform resources"

    action {
        action_type = "Octopus.TerraformDestroy"
        properties = {
            Octopus.Action.GoogleCloud.ImpersonateServiceAccount = "False"
            Octopus.Action.GoogleCloud.UseVMServiceAccount = "True"
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Terraform.AllowPluginDownloads = "True"
            Octopus.Action.Terraform.AzureAccount = "False"
            Octopus.Action.Terraform.GoogleCloudAccount = "False"
            Octopus.Action.Terraform.ManagedAccount = "None"
            Octopus.Action.Terraform.PlanJsonOutput = "False"
            Octopus.Action.Terraform.RunAutomaticFileSubstitution = "True"
            Octopus.Action.Terraform.Template = <<-EOT
                # main.tf
                
                terraform {
                  required_version = ">= 1.0.0"
                }
                
                # A mock variable you can easily manipulate to trigger simulated changes
                variable "mock_input" {
                  type    = string
                  default = "initial_mock_value"
                }
                
                # Uses the built-in standard provider to create a local, cost-free resource
                resource "terraform_data" "mock_resource" {
                  input = var.mock_input
                
                  # Optional: Simulated output fields
                  triggers_replace = {
                    seed = timestamp()
                  }
                }
                
                # Emulates a real stack output
                output "mock_output_id" {
                  value       = terraform_data.mock_resource.id
                  description = "The simulated ID generated by the mock plan."
                }
                
                EOT
            Octopus.Action.Terraform.TemplateParameters = "{\"mock_input\":\"initial_mock_value\"}"
        }
        worker_pool_variable = "#{Worker Pool}"
    }
}
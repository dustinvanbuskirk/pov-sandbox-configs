name = "Verify Build Artifacts"
description = "Create SBOM and verify attestation"

icon {
    color = "#1A77CA"
    id = "shield-check"
}

parameter "Worker Pool" {
    display_settings = {
        Octopus.ControlType = "WorkerPool"
    }
    help_text = ""
    label = ""
}

step "run-a-script" {
    name = "Create SBOM and verify attestation"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                #!/usr/bin/env bash
                #
                # mock-sbom-attestation.sh
                #
                # Stands in for the real Trivy / `gh attestation verify` calls described in
                # https://octopus.com/blog/supply-chain-security-with-platform-hub
                # so you can exercise Process Template / Policy logic (including the
                # guided-failure path) without a live GitHub Actions build, a real PAT,
                # or Trivy installed on the worker.
                #
                # Usage:
                #   ./mock-sbom-attestation.sh sbom-scan   <name> [pass|fail]
                #   ./mock-sbom-attestation.sh attest      <package-or-image> [pass|fail]
                #   ./mock-sbom-attestation.sh image-scan  <image> [pass|fail]
                #
                # Each subcommand mimics the real tool's contract:
                #   - prints Octopus-style Write-Host/Write-Highlight/Write-Error lines
                #   - writes an artifact-like JSON file to ./mock-artifacts/
                #   - returns exit code 0 on pass, 1 on fail (same as the real tools)
                #
                # Outcome resolution order (first match wins):
                #   1. explicit "pass"/"fail" arg
                #   2. MOCK_RESULT env var ("pass"/"fail")
                #   3. random (~80% pass) — good for fuzzing Policy behavior over many runs
                
                set -euo pipefail
                
                ARTIFACT_DIR="./mock-artifacts"
                mkdir -p "$ARTIFACT_DIR"
                
                resolve_outcome() {
                  local explicit="${1:-}"
                  if [[ "$explicit" == "pass" || "$explicit" == "fail" ]]; then
                    echo "$explicit"
                    return
                  fi
                  if [[ -n "${MOCK_RESULT:-}" ]]; then
                    echo "$MOCK_RESULT"
                    return
                  fi
                  # ~80% pass rate by default
                  if (( RANDOM % 10 < 8 )); then echo "pass"; else echo "fail"; fi
                }
                
                fake_cve() {
                  local n=$1
                  printf 'CVE-2025-%04d' "$((10000 + n))"
                }
                
                cmd_sbom_scan() {
                  local name="${1:?package/SBOM name required}"
                  local outcome
                  outcome=$(resolve_outcome "${2:-}")
                  local artifact="$ARTIFACT_DIR/${name}.sbom-scan.json"
                
                  echo "Attaching ${name}.sbom.json as an artifact"
                  echo "Running trivy (mock) to scan the SBOM for known fixed vulnerabilities"
                
                  if [[ "$outcome" == "pass" ]]; then
                    cat > "$artifact" <<EOF
                {"package":"$name","tool":"trivy(mock)","vulnerabilities":[],"result":"clean"}
                EOF
                    echo "[Highlight] Trivy successfully scanned the SBOM and no new vulnerabilities were found."
                    exit 0
                  else
                    local cve1 cve2
                    cve1=$(fake_cve 1); cve2=$(fake_cve 2)
                    cat > "$artifact" <<EOF
                {"package":"$name","tool":"trivy(mock)","vulnerabilities":["$cve1","$cve2"],"result":"vulnerable"}
                EOF
                    echo "[Error] Trivy found vulnerabilities ($cve1, $cve2) that must be fixed before this version can proceed." >&2
                    exit 1
                  fi
                }
                
                cmd_attest() {
                  local target="${1:?package or oci://image reference required}"
                  local outcome
                  outcome=$(resolve_outcome "${2:-}")
                  local name
                  name=$(echo "$target" | tr -c 'A-Za-z0-9._-' '_')
                  local artifact="$ARTIFACT_DIR/${name}.attestation.json"
                
                  echo "Verifying attestation (mock) for $target"
                
                  if [[ "$outcome" == "pass" ]]; then
                    cat > "$artifact" <<EOF
                {"subject":"$target","verified":true,"predicateType":"https://slsa.dev/provenance/v1","tool":"gh attestation verify(mock)"}
                EOF
                    echo "[Highlight] $target successfully passed attestation verification"
                    exit 0
                  else
                    cat > "$artifact" <<EOF
                {"subject":"$target","verified":false,"reason":"no attestation found or signature mismatch","tool":"gh attestation verify(mock)"}
                EOF
                    echo "[Error] The attestation for $target could not be verified - no attestation was generated or the package has been tampered with since it was created." >&2
                    exit 1
                  fi
                }
                
                cmd_image_scan() {
                  local image="${1:?image reference required}"
                  local outcome
                  outcome=$(resolve_outcome "${2:-}")
                
                  echo "Running trivy (mock) image scan on $image for known fixed vulnerabilities"
                
                  if [[ "$outcome" == "pass" ]]; then
                    echo "[Highlight] Trivy successfully scanned $image, no new vulnerabilities found."
                    exit 0
                  else
                    local cve1
                    cve1=$(fake_cve 3)
                    echo "[Error] Trivy found vulnerabilities ($cve1) in $image that must be fixed. You can no longer deploy this release." >&2
                    exit 1
                  fi
                }
                
                usage() {
                  cat <<EOF
                Usage:
                  $0 sbom-scan   <name>              [pass|fail]
                  $0 attest      <package-or-image>  [pass|fail]
                  $0 image-scan  <image>             [pass|fail]
                
                Environment:
                  MOCK_RESULT=pass|fail   forces every unspecified call to that outcome
                EOF
                  exit 1
                }
                
                case "${1:-}" in
                  sbom-scan)  shift; cmd_sbom_scan "$@" ;;
                  attest)     shift; cmd_attest "$@" ;;
                  image-scan) shift; cmd_image_scan "$@" ;;
                  *) usage ;;
                esac
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
        worker_pool_variable = "#{Worker Pool}"
    }
}